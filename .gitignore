
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/

# Compiled vite config output (tsc -b compiles vite.config.ts alongside the source;
# these shadow the real config when present, so they must never be committed)
apps/*/vite.config.js
apps/*/vite.config.d.ts

# Environment files (NEVER commit secrets)
**/.env
**/.env.*
!**/.env.example

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Docker volumes
postgres-data/
redis-data/

# Coverage
coverage/
.nyc_output/

# Prisma
prisma/migrations/migration_lock.toml

# Temp
tmp/
temp/
