generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
 url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Event {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  date            DateTime
  status          EventStatus      @default(UPCOMING)
  branding        Json?
  registrationOpen Boolean        @default(true)
  maxParticipants Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  participants    Participant[]
  raceDistances   RaceDistance[]
  checkpoints     Checkpoint[]
  sponsors        Sponsor[]
  announcements   Announcement[]
  treeCounter     TreeCounter?
  settings        Setting[]

  @@map("events")
}

model RaceDistance {
  id              String           @id @default(cuid())
  eventId         String           @map("event_id")
  name            String
  distanceKm      Float            @map("distance_km")
  status          RaceStatus       @default(UPCOMING)
  totalDistance   Float            @default(0) @map("total_distance")
  routeGeojson    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routePoints     RoutePoint[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("race_distances")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  phone         String        @unique
  name          String
  passwordHash  String        @map("password_hash")
  avatarUrl     String?       @map("avatar_url")
  role          UserRole      @default(PARTICIPANT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  participants  Participant[]

  @@map("users")
}

model Company {
  id             String        @id @default(cuid())
  name           String        @unique
  logoUrl        String?       @map("logo_url")
  industry       String?
  employeeCount  Int?          @map("employee_count")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  participants   Participant[]

  @@map("companies")
}

model Participant {
  id              String           @id @default(cuid())
  eventId         String           @map("event_id")
  userId          String           @map("user_id")
  companyId       String?          @map("company_id")
  bibNumber       String           @unique @map("bib_number")
  category        Category
  gender          Gender
  checkedIn       Boolean          @default(false) @map("checked_in")
  checkedInAt     DateTime?        @map("checked_in_at")
  startedAt       DateTime?        @map("started_at")
  finishedAt      DateTime?        @map("finished_at")
  totalDistance    Float            @default(0) @map("total_distance")
  finishTime      Int?             @map("finish_time")
  pace            Float?
  treesCount      Int              @default(0) @map("trees_count")
  qrCodeUrl       String?          @map("qr_code_url")
  certificateUrl  String?          @map("certificate_url")
  status          ParticipantStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus    @default(PENDING)
  paymentAmount   Int?             @map("payment_amount")
  emergencyContact String?         @map("emergency_contact")
  emergencyPhone  String?          @map("emergency_phone")
  bloodGroup      String?          @map("blood_group")
  tshirtSize      String?          @map("tshirt_size")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event           Event            @relation(fields: [eventId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id])
  gpsLogs         GpsLog[]
  payments        Payment[]

  @@index([eventId, category])
  @@index([eventId, status])
  @@index([companyId])
  @@map("participants")
}

model GpsLog {
  id            String     @id @default(cuid())
  participantId String     @map("participant_id")
  lat           Float
  lng           Float
  accuracy      Float?
  speed         Float?
  altitude      Float?
  timestamp     DateTime
  snappedLat    Float?     @map("snapped_lat")
  snappedLng    Float?     @map("snapped_lng")
  routeDistance  Float?     @map("route_distance")
  isOutlier     Boolean    @default(false) @map("is_outlier")
  createdAt     DateTime   @default(now())

  participant   Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, timestamp])
  @@map("gps_logs")
}

model RoutePoint {
  id              String   @id @default(cuid())
  raceDistanceId  String   @map("race_distance_id")
  sequence        Int
  lat             Float
  lng             Float
  cumDistance     Float    @default(0) @map("cum_distance")
  createdAt       DateTime @default(now())

  raceDistance     RaceDistance @relation(fields: [raceDistanceId], references: [id], onDelete: Cascade)

  @@unique([raceDistanceId, sequence])
  @@index([raceDistanceId])
  @@map("route_points")
}

model Checkpoint {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  name        String
  lat         Float
  lng         Float
  distanceKm  Float    @map("distance_km")
  type        String   @default("water")
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id])

  @@map("checkpoints")
}

model Sponsor {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  name         String
  tier         String
  logoUrl      String?  @map("logo_url")
  website      String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id])

  @@map("sponsors")
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  title     String
  message   String
  type      String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])

  @@map("announcements")
}

model TreeCounter {
  id         String   @id @default(cuid())
  eventId    String   @unique @map("event_id")
  totalTrees Int      @default(0) @map("total_trees")
  totalKm    Float    @default(0) @map("total_km")
  totalCO2   Float    @default(0) @map("total_co2")
  updatedAt  DateTime @updatedAt

  event      Event    @relation(fields: [eventId], references: [id])

  @@map("tree_counter")
}

model Setting {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
  @@map("settings")
}

model Payment {
  id              String        @id @default(cuid())
  participantId   String        @map("participant_id")
  razorpayOrderId String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?     @map("razorpay_payment_id")
  razorpaySignature String?    @map("razorpay_signature")
  amount          Int
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  description     String?
  failureReason   String?       @map("failure_reason")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  participant     Participant   @relation(fields: [participantId], references: [id])

  @@index([participantId])
  @@index([razorpayOrderId])
  @@map("payments")
}

enum EventStatus {
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RaceStatus {
  UPCOMING
  STARTED
  PAUSED
  COMPLETED
}

enum Category {
  RUN_3K
  RUN_5K
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum ParticipantStatus {
  PENDING_PAYMENT
  REGISTERED
  CHECKED_IN
  RUNNING
  PAUSED
  FINISHED
  DNF
  DNS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum UserRole {
  PARTICIPANT
  SUPER_ADMIN
  RACE_MANAGER
  CHECKIN_STAFF
  ANALYTICS_VIEWER
}
