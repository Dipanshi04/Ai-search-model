generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Event {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  date            DateTime
  status          EventStatus      @default(UPCOMING)
  // Explicit admin pin for "which event public displays (LED board,
  // spectator app) should show." Without this, every display independently
  // guessed via the ACTIVE/PAUSED-then-next-UPCOMING heuristic below, which
  // silently breaks the moment there's more than one event in the system.
  isFeatured      Boolean          @default(false) @map("is_featured")
  totalDistance    Float            @default(0)
  routeGeojson    String?
  branding        Json?
  registrationOpen Boolean        @default(true)
  maxParticipants Int?
  accumulatedElapsedMs Int         @default(0) @map("accumulated_elapsed_ms")
  startedAt       DateTime?        @map("started_at")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  participants    Participant[]
  raceDistances   RaceDistance[]
  checkpoints     Checkpoint[]
  sponsors        Sponsor[]
  announcements   Announcement[]
  treeCounter     TreeCounter?
  settings        Setting[]

  @@map("events")
}

model RaceDistance {
  id              String           @id @default(cuid())
  eventId         String           @map("event_id")
  name            String
  distanceKm      Float            @map("distance_km")
  status          RaceStatus       @default(UPCOMING)
  totalDistance   Float            @default(0) @map("total_distance")
  routeGeojson    String?          @map("routegeojson")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routePoints     RoutePoint[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("race_distances")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  phone         String        @unique
  name          String
  passwordHash  String        @map("password_hash")
  pinHash       String?       @map("pin_hash")
  avatarUrl     String?       @map("avatar_url")
  role          UserRole      @default(PARTICIPANT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  participants  Participant[]

  @@map("users")
}

model Company {
  id             String        @id @default(cuid())
  name           String        @unique
  logoUrl        String?       @map("logo_url")
  industry       String?
  employeeCount  Int?          @map("employee_count")
  contactEmail   String?       @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  status         CompanyStatus @default(NON_PREMIUM)
  membershipStartDate DateTime? @map("membership_start_date")
  membershipEndDate   DateTime? @map("membership_end_date")
  renewalPending      Boolean   @default(false) @map("renewal_pending")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  participants         Participant[]
  bulkRegistrations    BulkRegistration[]

  @@map("companies")
}

model Participant {
  id              String           @id @default(cuid())
  eventId         String           @map("event_id")
  userId          String           @map("user_id")
  companyId       String?          @map("company_id")
  bibNumber       String           @unique @map("bib_number")
  category        Category
  gender          Gender
  checkedIn       Boolean          @default(false) @map("checked_in")
  checkedInAt     DateTime?        @map("checked_in_at")
  startedAt       DateTime?        @map("started_at")
  finishedAt      DateTime?        @map("finished_at")
  totalDistance    Float            @default(0) @map("total_distance")
  finishTime      Int?             @map("finish_time")
  pace            Float?
  treesCount      Int              @default(0) @map("trees_count")
  qrCodeUrl       String?          @map("qr_code_url")
  certificateUrl  String?          @map("certificate_url")
  status          ParticipantStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus    @default(PENDING)
  paymentAmount   Int?             @map("payment_amount")
  emergencyContact String?         @map("emergency_contact")
  emergencyPhone  String?          @map("emergency_phone")
  bloodGroup      String?          @map("blood_group")
  bloodDonation   Boolean          @default(false) @map("blood_donation")
  tshirtSize      String?          @map("tshirt_size")
  kitDistributed  Boolean          @default(false) @map("kit_distributed")
  foodDistributed Boolean          @default(false) @map("food_distributed")
  bulkRegistrationId String?       @map("bulk_registration_id")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event           Event            @relation(fields: [eventId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id])
  bulkRegistration BulkRegistration? @relation(fields: [bulkRegistrationId], references: [id])
  gpsLogs         GpsLog[]
  payments        Payment[]

  @@index([eventId, category])
  @@index([eventId, status])
  @@index([companyId])
  @@index([bulkRegistrationId])
  @@map("participants")
}

model GpsLog {
  id            String     @id @default(cuid())
  participantId String     @map("participant_id")
  lat           Float
  lng           Float
  accuracy      Float?
  speed         Float?
  altitude      Float?
  timestamp     DateTime
  snappedLat    Float?     @map("snapped_lat")
  snappedLng    Float?     @map("snapped_lng")
  routeDistance  Float?     @map("route_distance")
  isOutlier     Boolean    @default(false) @map("is_outlier")
  createdAt     DateTime   @default(now())

  participant   Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, timestamp])
  @@map("gps_logs")
}

model RoutePoint {
  id              String   @id @default(cuid())
  raceDistanceId  String   @map("race_distance_id")
  sequence        Int
  lat             Float
  lng             Float
  cumDistance     Float    @default(0) @map("cum_distance")
  createdAt       DateTime @default(now())

  raceDistance     RaceDistance @relation(fields: [raceDistanceId], references: [id], onDelete: Cascade)

  @@unique([raceDistanceId, sequence])
  @@index([raceDistanceId])
  @@map("route_points")
}

model Checkpoint {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  name        String
  lat         Float
  lng         Float
  distanceKm  Float    @map("distance_km")
  type        String   @default("water")
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id])

  @@map("checkpoints")
}

model Sponsor {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  name         String?
  tier         String?
  logoUrl      String?  @map("logo_url")
  website      String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id])

  @@map("sponsors")
}

// Inbound leads from the homepage "Open For Sponsors" button — not tied to
// one event since a prospective sponsor is reaching out generally, before
// any specific event assignment makes sense.
model SponsorInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  companyName String   @map("company_name")
  message     String?
  status      String   @default("NEW") // NEW | CONTACTED | CLOSED — admin-set, not a fixed enum since the triage flow may evolve
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sponsor_inquiries")
}

model Announcement {
  id        String    @id @default(cuid())
  eventId   String    @map("event_id")
  title     String
  message   String
  type      String    @default("info")
  location  String?
  url       String?
  phone     String?
  eventDate DateTime? @map("event_date")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event     Event     @relation(fields: [eventId], references: [id])

  @@index([eventId, active])
  @@map("announcements")
}

model TreeCounter {
  id         String   @id @default(cuid())
  eventId    String   @unique @map("event_id")
  totalTrees Int      @default(0) @map("total_trees")
  totalKm    Float    @default(0) @map("total_km")
  totalCO2   Float    @default(0) @map("total_co2")
  updatedAt  DateTime @updatedAt

  event      Event    @relation(fields: [eventId], references: [id])

  @@map("tree_counter")
}

model Setting {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
  @@map("settings")
}

model Payment {
  id              String          @id @default(cuid())
  participantId   String          @map("participant_id")
  provider        PaymentProvider @default(RAZORPAY)
  razorpayOrderId String?         @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  // Our own correlation id, minted before the runner ever leaves the site and
  // never trusted from a query param — the one thing a redirect-only gateway
  // integration can't spoof, because we never accept it back from the client.
  reference       String?         @unique
  // Whatever the return redirect carried (their order id, a success flag, etc).
  // Captured for a human to reconcile against the provider's own sales report —
  // never used to auto-decide payment status for a provider with no signed webhook.
  externalRef     String?         @map("external_ref")
  returnParams    Json?           @map("return_params")
  amount          Int
  currency        String          @default("INR")
  status          PaymentStatus   @default(PENDING)
  description     String?
  failureReason   String?         @map("failure_reason")
  paidAt          DateTime?       @map("paid_at")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  participant     Participant     @relation(fields: [participantId], references: [id])

  @@index([participantId])
  @@index([razorpayOrderId])
  @@index([provider, status])
  @@map("payments")
}

enum PaymentProvider {
  RAZORPAY
  SHOWTIMEBRO
  CASHFREE
}

enum CompanyStatus {
  PREMIUM
  NON_PREMIUM
}

model BulkRegistration {
  id                    String        @id @default(cuid())
  companyId             String?       @map("company_id")
  companyName           String        @map("company_name")
  hrName                String        @map("hr_name")
  hrEmail               String        @unique @map("hr_email")
  hrPasswordHash        String        @map("hr_password_hash")
  numberOfRegistrations Int           @map("number_of_registrations")
  paymentCompleted      Boolean       @default(false) @map("payment_completed")
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company               Company?      @relation(fields: [companyId], references: [id])
  participants          Participant[]

  @@map("bulk_registrations")
}

enum EventStatus {
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RaceStatus {
  UPCOMING
  STARTED
  PAUSED
  COMPLETED
}

enum Category {
  RUN_3K
  RUN_5K
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum ParticipantStatus {
  PENDING_PAYMENT
  REGISTERED
  CHECKED_IN
  RUNNING
  PAUSED
  FINISHED
  DNF
  DNS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  // The return redirect said success, but for a provider with no signed
  // webhook that claim is unverified until an admin reconciles it.
  CLAIMED
  COMPLETED
  FAILED
  REFUNDED
}

enum UserRole {
  PARTICIPANT
  SUPER_ADMIN
  RACE_MANAGER
  CHECKIN_STAFF
  ANALYTICS_VIEWER
  HR
}